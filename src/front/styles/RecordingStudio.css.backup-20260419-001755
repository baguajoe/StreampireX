/* RecordingStudio.css — matches RecordingStudio.js exactly */
:root {
  --rs-bg: #13161e; --rs-bg2: #1a1e2a; --rs-bg3: #1e2436;
  --rs-surface: #242b3d; --rs-border: #2a3248; --rs-border2: #1e2638;
  --rs-teal: #00ffc8; --rs-orange: #ff6600; --rs-red: #ff3b30;
  --rs-green: #34c759; --rs-yellow: #ffd700; --rs-purple: #a78bfa;
  --rs-text: #cdd9e5; --rs-text2: #8ba3bc; --rs-text3: #4e6a82;
  --rs-font: "JetBrains Mono","Consolas","SF Mono",monospace;
}
.daw { position:fixed; top:0; left:0; right:0; bottom:0; width:100vw; height:100vh; z-index:1300; display:flex; flex-direction:column; background:var(--rs-bg); color:var(--rs-text); font-family:var(--rs-font); font-size:12px; overflow:visible; }
.daw-topbar { background:var(--rs-bg2); border-bottom:1px solid var(--rs-border); flex-shrink:0; overflow:visible; position:relative; z-index:2000; }
.daw-topbar-row1 { display:flex; align-items:center; gap:6px; padding:0 10px; height:50px; overflow:visible; }
.daw-topbar-row2 { display:flex; align-items:center; height:40px; padding:0 10px; border-top:1px solid var(--rs-border2); }
.daw-topbar-left { display:flex; align-items:center; gap:4px; }
.daw-topbar-right { display:flex; align-items:center; gap:6px; margin-left:auto; }
.daw-icon-btn { background:transparent; border:1px solid transparent; border-radius:4px; color:var(--rs-text3); cursor:pointer; display:flex; align-items:center; justify-content:center; height:26px; width:26px; transition:all .15s; flex-shrink:0; }
.daw-icon-btn:hover { border-color:var(--rs-border); color:var(--rs-text); background:var(--rs-surface); }
.daw-icon-btn.active { border-color:var(--rs-teal); color:var(--rs-teal); background:rgba(0,255,200,.08); }
.daw-icon-btn.saving { opacity:.5; pointer-events:none; }
.daw-divider { width:1px; height:20px; background:var(--rs-border); margin:0 2px; flex-shrink:0; }
.daw-project-name { background:transparent; border:1px solid transparent; border-radius:4px; color:var(--rs-text); font-family:var(--rs-font); font-size:12px; font-weight:600; padding:3px 6px; width:160px; }
.daw-project-name:hover { border-color:var(--rs-border); }
.daw-project-name:focus { border-color:var(--rs-teal); outline:none; background:var(--rs-surface); }
.daw-transport { display:flex; align-items:center; gap:3px; padding:0 8px; background:var(--rs-bg3); border:1px solid var(--rs-border); border-radius:6px; height:38px; flex-shrink:0; }
.daw-transport-btn { background:transparent; border:none; border-radius:4px; color:var(--rs-text2); cursor:pointer; display:flex; align-items:center; justify-content:center; font-family:var(--rs-font); font-size:11px; height:28px; min-width:28px; padding:0 4px; transition:all .12s; }
.daw-transport-btn:hover { background:var(--rs-surface); color:var(--rs-text); }
.daw-transport-btn:disabled { opacity:.4; cursor:not-allowed; }
.daw-play-btn.active { color:var(--rs-teal); background:rgba(0,255,200,.08); }
.daw-rec-btn { color:var(--rs-text3); }
.daw-rec-btn.active { color:var(--rs-red); }
.daw-rec-dot { display:inline-block; width:9px; height:9px; border-radius:50%; background:currentColor; }
.daw-metro-btn.active { color:var(--rs-orange); }
.rs-transport-label { font-size:10px; font-weight:700; letter-spacing:1px; }
.daw-lcd { background:#06090f; border:1px solid #1a2436; border-radius:4px; padding:3px 10px; display:flex; align-items:center; gap:8px; min-width:140px; flex-shrink:0; }
.daw-lcd-time { color:var(--rs-teal); font-size:15px; font-weight:700; letter-spacing:1.5px; font-variant-numeric:tabular-nums; }
.daw-lcd-sep { color:var(--rs-text3); }
.daw-lcd-bpm { color:var(--rs-orange); font-size:12px; font-weight:700; }
.rs-split-toggle-btn { display:flex; align-items:center; gap:4px; background:transparent; border:1px solid var(--rs-border); border-radius:4px; color:var(--rs-text3); cursor:pointer; font-size:10px; font-family:var(--rs-font); font-weight:700; height:28px; padding:0 8px; transition:all .15s; flex-shrink:0; }
.rs-split-toggle-btn:hover { border-color:var(--rs-teal); color:var(--rs-teal); }
.rs-split-toggle-btn.active { border-color:var(--rs-teal); color:var(--rs-teal); background:rgba(0,255,200,.08); }
.daw-monitor-row { display:flex; align-items:center; gap:4px; flex-shrink:0; }
.daw-monitor-label { color:var(--rs-text3); font-size:10px; white-space:nowrap; }
.daw-monitor-select { background:var(--rs-surface); border:1px solid var(--rs-border); border-radius:4px; color:var(--rs-text); font-family:var(--rs-font); font-size:10px; padding:2px 4px; max-width:150px; }
.daw-monitor-select.pro { border-color:rgba(0,255,200,.4); color:var(--rs-teal); }
.daw-monitor-select.consumer { border-color:rgba(255,102,0,.4); color:var(--rs-orange); }
.daw-latency-badge { font-size:10px; padding:2px 7px; border-radius:10px; border:1px solid; flex-shrink:0; }
.daw-latency-badge.good { border-color:var(--rs-green); color:var(--rs-green); }
.daw-latency-badge.ok { border-color:var(--rs-yellow); color:var(--rs-yellow); }
.daw-latency-badge.bad { border-color:var(--rs-red); color:var(--rs-red); }
.daw-input-select { background:var(--rs-surface); border:1px solid var(--rs-border); border-radius:4px; color:var(--rs-text); font-family:var(--rs-font); font-size:10px; padding:2px 4px; max-width:120px; }
.daw-input-meter { width:56px; height:6px; background:var(--rs-bg); border-radius:3px; overflow:hidden; border:1px solid var(--rs-border2); flex-shrink:0; }
.daw-input-meter-fill { height:100%; background:var(--rs-teal); border-radius:3px; transition:width .05s; }
.daw-status { color:var(--rs-text3); font-size:10px; max-width:180px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.rs-wam-badge { background:rgba(0,255,200,.08); border:1px solid rgba(0,255,200,.25); border-radius:10px; flex-shrink:0; }
.rs-wam-text { color:var(--rs-teal); font-size:10px; padding:2px 8px; display:block; }
.daw-tabs-row { display:flex; align-items:center; height:100%; }
.daw-view-tab { background:transparent; border:none; border-bottom:2px solid transparent; color:var(--rs-text); cursor:pointer; font-family:var(--rs-font); font-size:13px; height:40px; padding:0 14px; transition:all .15s; white-space:nowrap; }
.daw-view-tab:hover { color:var(--rs-text); background:rgba(255,255,255,.03); }
.daw-view-tab.active { color:var(--rs-teal); border-bottom-color:var(--rs-teal); }
.daw-mix-dropdown { position:relative; }
.daw-mix-dropdown-btn { background:transparent; border:none; border-bottom:2px solid transparent; color:var(--rs-text2); cursor:pointer; font-family:var(--rs-font); font-size:13px; height:36px; padding:0 14px; transition:all .15s; }
.daw-mix-dropdown-btn:hover { color:var(--rs-text); }
.daw-mix-dropdown-btn.active { color:var(--rs-orange); border-bottom-color:var(--rs-orange); }
.daw-mix-dropdown-menu { position:absolute; top:100%; left:0; background:var(--rs-bg2); border:1px solid var(--rs-border); border-radius:6px; min-width:160px; z-index:300; box-shadow:0 8px 24px rgba(0,0,0,.6); }
.daw-mix-dropdown-item { display:block; width:100%; background:transparent; border:none; color:var(--rs-text2); cursor:pointer; font-family:var(--rs-font); font-size:11px; padding:8px 16px; text-align:left; transition:background .1s; }
.daw-mix-dropdown-item:hover { background:var(--rs-surface); color:var(--rs-text); }
.daw-mix-dropdown-item.active { color:var(--rs-orange); }
.daw-main { flex:1; overflow:hidden; position:relative; background:var(--rs-bg); }
.rs-relative { position:relative; height:100%; }
.daw-pianoroll-view,.daw-chords-view,.daw-piano-view,.daw-freesound-view,.daw-aibeat-view,.daw-voicemidi-view { height:100%; overflow:hidden; }
.daw-vocal-view,.daw-aimix-view { height:100%; overflow-y:auto; }
.daw-keyfinder-view { height:100%; overflow:hidden; display:flex; flex-direction:column; }
.daw-synth-view,.daw-drumdesigner-view,.daw-instrbuilder-view { height:100%; overflow:auto; }
.daw-flexpitch-overlay { height:100%; overflow:hidden; }
.rs-view-full { height:100%; overflow:hidden; }
.rs-view-scroll { height:100%; overflow-y:auto; }
.rs-view-auto { height:100%; overflow:auto; }
.rs-flex-hidden { display:flex; flex-direction:column; height:100%; overflow:hidden; }
.rs-flex-scroll-dark { display:flex; flex-direction:column; height:100%; overflow-y:auto; background:#0e1520; padding:12px; }
.rs-flex-scroll-darker { display:flex; flex-direction:column; height:100%; overflow-y:auto; background:#0a1018; }
.daw-console { display:flex; flex-direction:column; height:100%; overflow:auto; background:#0f1520; }
.daw-console-scroll { display:flex; flex-direction:row; align-items:stretch; gap:2px; padding:8px 8px 32px; overflow-x:auto; overflow-y:auto; height:100%; background:#0c111c; }
.daw-channel { display:flex; flex-direction:column; align-items:center; background:#181e2d; border:1px solid #243048; border-radius:6px; cursor:pointer; flex-shrink:0; width:90px; min-width:90px; height:680px; min-height:680px; max-height:680px; padding-bottom:16px; overflow:visible; transition:border-color .15s, background .15s; }
.daw-channel:hover { border-color:#2e3d5a; background:#1e263a; }
.daw-channel.selected { border-color:var(--rs-teal); background:rgba(0,255,200,.12); }
.daw-channel.armed { border-color:rgba(255,59,48,.6); }
.daw-channel.master-channel { width:100px; min-width:100px; height:680px; min-height:680px; max-height:680px; padding-bottom:24px; overflow:visible; padding-bottom:8px; border-color:rgba(255,102,0,.3); }
.daw-channel.master-channel.selected { border-color:var(--rs-orange) !important; background:rgba(0,255,200,.12) !important; }
.daw-ch-colorbar { width:100%; height:5px; border-radius:5px 5px 0 0; flex-shrink:0; }
.daw-ch-header { display:flex; align-items:center; gap:4px; padding:5px 6px; width:100%; }
.daw-ch-type-icon { font-size:11px; }
.daw-ch-header-num { color:#00ffc8; font-size:13px; font-weight:700; }
.daw-ch-routing { padding:0 6px 3px; width:100%; }
.daw-ch-routing-value { color:#cdd9e5; font-size:11px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block; }
.daw-ch-inserts { padding:3px 4px; width:100%; height:140px; min-height:140px; max-height:140px; overflow-y:auto; flex-shrink:0; }
.daw-ch-inserts-label { color:#8ba3bc; font-size:10px; font-weight:700; letter-spacing:1.5px; letter-spacing:1px; text-transform:uppercase; padding:0 2px 3px; display:block; }
.daw-ch-insert-slot { border-radius:3px; cursor:pointer; font-size:9px; margin-bottom:2px; overflow:hidden; padding:3px 6px; text-overflow:ellipsis; white-space:nowrap; border:1px solid; transition:all .1s; }
.daw-ch-insert-slot.empty { background:rgba(255,255,255,.02); border-color:var(--rs-border2); color:var(--rs-text3); }
.daw-ch-insert-slot.empty:hover { border-color:var(--rs-teal); color:var(--rs-teal); }
.daw-ch-insert-slot.active { background:rgba(0,255,200,.07); border-color:rgba(0,255,200,.3); color:var(--rs-teal); }
.daw-ch-insert-slot.active.vocal { background:rgba(167,139,250,.1); border-color:rgba(167,139,250,.4); color:var(--rs-purple); }
.daw-ch-controls { display:flex; align-items:center; gap:3px; padding:4px; width:100%; }
.daw-ch-badge { border-radius:3px; cursor:pointer; font-size:10px; font-weight:700; height:20px; min-width:20px; display:flex; align-items:center; justify-content:center; padding:0 3px; font-family:var(--rs-font); border:1px solid #1e2a3e; color:var(--rs-text3); background:transparent; transition:all .12s; user-select:none; }
.daw-ch-badge.m-on { background:#6a4400; border-color:#c07800; color:#ffc060; }
.daw-ch-badge.s-on { background:#003a2a; border-color:#008060; color:var(--rs-teal); }
.daw-ch-badge.e-on { background:rgba(0,255,200,.1); border-color:rgba(0,255,200,.4); color:var(--rs-teal); }
.daw-ch-rec-btn { border-radius:50%; border:1px solid #1e2a3e; background:transparent; color:#555; cursor:pointer; font-size:9px; height:20px; width:20px; display:flex; align-items:center; justify-content:center; transition:all .12s; flex-shrink:0; padding:0; }
.daw-ch-rec-btn.armed { border-color:var(--rs-red); color:var(--rs-red); background:rgba(255,59,48,.12); animation:rs-pulse 1.4s ease-in-out infinite; }
@keyframes rs-pulse { 0%,100%{opacity:1}50%{opacity:.45} }
.daw-ch-btn { background:transparent; border:1px solid #1e2a3e; border-radius:3px; color:var(--rs-text3); cursor:pointer; font-family:var(--rs-font); font-size:10px; font-weight:700; height:20px; min-width:22px; padding:0 3px; transition:all .12s; }
.daw-ch-btn:hover { color:var(--rs-text); border-color:var(--rs-text3); }
.daw-ch-btn.mute.active { background:#6a4400; border-color:#c07800; color:#ffc060; }
.daw-ch-btn.solo.active { background:#003a2a; border-color:#008060; color:var(--rs-teal); }
.daw-ch-pan { display:flex; flex-direction:column; align-items:center; padding:4px 0; gap:2px; }
.daw-ch-pan-val { color:var(--rs-text2); font-weight:600; font-size:9px; }
.daw-ch-fader-area { display:flex; flex-direction:column; align-items:center; padding:4px; width:100%; height:220px; min-height:220px; max-height:220px; flex-shrink:0;  }
.daw-ch-fader-row { display:flex; align-items:flex-end; gap:4px; width:100%; justify-content:center; height:180px; flex-shrink:0; }
.daw-ch-fader { display:flex; align-items:flex-end; justify-content:center; height:180px; flex-shrink:0; }
.daw-ch-fader input[type="range"] { appearance:none; writing-mode:vertical-lr; direction:rtl; width:18px; height:180px; cursor:pointer; background:#060a10; border-radius:1px; border:1px solid #0d1520; }
.daw-ch-fader input[type="range"]::-webkit-slider-thumb {
  appearance:none;
  width:52px;
  height:18px;
  border-radius:2px;
  background:
    linear-gradient(180deg, transparent 47%, #1a1a1a 47%, #1a1a1a 53%, transparent 53%),
    linear-gradient(180deg, #d0d4dc 0%, #a8b0bc 30%, #8090a4 50%, #a0aab8 70%, #ccd0d8 100%);
  border:1px solid #506070;
  border-top:2px solid #e8ecf0;
  border-bottom:2px solid #404850;
  cursor:grab;
  box-shadow:0 3px 8px rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.3);
}
.daw-ch-meter { width:16px; height:200px; background:#060a0e; border-radius:2px; overflow:hidden; border:1px solid #0d1219; display:flex; flex-direction:column; justify-content:flex-end; flex-shrink:0; }
.daw-ch-meter-bar { width:100%; border-radius:2px 2px 0 0; transition:height .04s; min-height:0; }
.daw-cubase-meter { display:block; flex-shrink:0; }
.daw-midi-preview { display:block; }
.daw-ch-vol-display { text-align:center; padding:3px 0; width:100%; }
.daw-ch-vol-readout,.daw-ch-vol-val { color:#8ba3bc; font-size:10px; font-weight:600; font-variant-numeric:tabular-nums; }
.rs-orange { color:var(--rs-orange) !important; }
.daw-ch-automation { display:flex; gap:4px; padding:3px 4px; }
.daw-ch-rw { border-radius:3px; border:1px solid #1a2636; color:var(--rs-text3); cursor:pointer; font-size:9px; font-weight:700; height:18px; min-width:18px; display:flex; align-items:center; justify-content:center; font-family:var(--rs-font); user-select:none; }
.daw-ch-rw.active { background:rgba(255,102,0,.15); border-color:rgba(255,102,0,.5); color:var(--rs-orange); }
.daw-ch-name { display:flex; flex-direction:column; align-items:center; gap:3px; padding:4px 4px 2px; width:100%; }
.daw-ch-name-bottom { flex-direction:column-reverse; }
.daw-ch-name-input { background:var(--rs-surface); border:1px solid var(--rs-border); border-radius:3px; color:var(--rs-text); font-family:var(--rs-font); font-size:12px; padding:2px 4px; text-align:center; width:100%; }
.daw-ch-console-select { background:var(--rs-surface); border:1px solid var(--rs-border); border-radius:3px; color:var(--rs-text2); font-family:var(--rs-font); font-size:9px; padding:1px 2px; width:100%; }
.daw-ch-track-label { font-size:13px; font-weight:700; color:#cdd9e5 !important; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; width:100%; text-align:center; }
.rs-master-label { color:var(--rs-orange); font-size:11px; font-weight:700; letter-spacing:1px; }
.daw-ch-mic-btn { background:rgba(255,255,255,.03); border:1px solid var(--rs-border); border-radius:3px; color:var(--rs-text3); cursor:pointer; font-size:9px; font-family:var(--rs-font); padding:2px 4px; width:100%; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; transition:all .12s; }
.daw-ch-mic-btn:hover { border-color:var(--rs-teal); color:var(--rs-teal); }
.daw-ch-mic-btn.active { background:rgba(0,255,200,.08); border-color:rgba(0,255,200,.4); color:var(--rs-teal); }
.daw-ch-mic-popup { position:absolute; top:100%; left:0; background:var(--rs-bg2); border:1px solid var(--rs-border); border-radius:6px; box-shadow:0 8px 24px rgba(0,0,0,.7); max-height:240px; overflow-y:auto; width:200px; z-index:400; }
.daw-ch-mic-item { cursor:pointer; padding:6px 10px; transition:background .1s; }
.daw-ch-mic-item:hover { background:var(--rs-surface); }
.daw-ch-mic-item.active { background:rgba(0,255,200,.07); }
.daw-ch-mic-item-name { color:var(--rs-text); font-size:10px; font-weight:600; }
.daw-ch-mic-item-desc { color:var(--rs-text3); font-size:9px; margin-top:1px; }
.rs-split-screen { display:flex; flex-direction:column; height:100%; overflow:auto; }
.rs-split-top,.rs-split-bottom { overflow:auto; position:relative; display:flex; flex-direction:column; }
.rs-split-handle { background:var(--rs-border); cursor:ns-resize; flex-shrink:0; height:5px; transition:background .1s; }
.rs-split-handle:hover { background:var(--rs-teal); }
.rs-split-pane-label { color:var(--rs-text3); font-size:9px; letter-spacing:1.5px; padding:3px 10px; text-transform:uppercase; background:var(--rs-bg3); border-bottom:1px solid var(--rs-border2); flex-shrink:0; }
.daw-audio-settings-overlay { background:rgba(0,0,0,.7); backdrop-filter:blur(4px); bottom:0; display:flex; align-items:center; justify-content:center; left:0; position:fixed; right:0; top:0; z-index:600; }
.daw-audio-settings-panel { background:var(--rs-bg2); border:1px solid var(--rs-border); border-radius:8px; box-shadow:0 20px 60px rgba(0,0,0,.8); padding:24px; width:380px; }
.daw-audio-settings-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.rs-settings-title { color:var(--rs-text); font-size:14px; font-weight:700; letter-spacing:1px; }
.rs-close-btn { background:transparent; border:none; color:var(--rs-text3); cursor:pointer; font-size:18px; line-height:1; }
.rs-close-btn:hover { color:var(--rs-text); }
.rs-settings-section { margin-bottom:16px; }
.rs-settings-label { color:var(--rs-text3); display:block; font-size:10px; letter-spacing:1px; margin-bottom:8px; text-transform:uppercase; }
.rs-settings-row { display:flex; gap:6px; flex-wrap:wrap; }
.daw-settings-size-btn,.daw-settings-sr-btn { border-radius:4px; border:1px solid; cursor:pointer; font-family:var(--rs-font); font-size:11px; padding:5px 10px; transition:all .12s; }
.daw-settings-size-btn.active,.daw-settings-sr-btn.active { background:rgba(0,255,200,.12); border-color:var(--rs-teal); color:var(--rs-teal); }
.daw-settings-size-btn.inactive,.daw-settings-sr-btn.inactive { background:var(--rs-surface); border-color:var(--rs-border); color:var(--rs-text2); }
.rs-latency-box { background:var(--rs-bg); border:1px solid var(--rs-border2); border-radius:4px; padding:10px 14px; margin-bottom:16px; }
.rs-stat-row { display:flex; justify-content:space-between; padding:3px 0; border-bottom:1px solid var(--rs-border2); }
.rs-stat-row-last { display:flex; justify-content:space-between; padding:3px 0; }
.rs-stat-label { color:var(--rs-text3); font-size:10px; }
.rs-stat-val { color:var(--rs-text2); font-size:10px; }
.rs-stat-val-teal { color:var(--rs-teal); font-size:10px; font-weight:700; }
.rs-hint { color:var(--rs-text3); font-size:10px; margin-top:6px; }
.rs-hint-center { color:var(--rs-text3); font-size:10px; text-align:center; margin-top:12px; }
.rs-hint-sm { color:var(--rs-text3); font-size:9px; margin-top:6px; }
.rs-range-teal { width:100%; cursor:pointer; accent-color:var(--rs-teal); margin-top:6px; }
.rs-range-orange { width:100%; cursor:pointer; accent-color:var(--rs-orange); margin-top:6px; }
