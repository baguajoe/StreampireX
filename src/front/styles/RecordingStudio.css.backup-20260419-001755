/* dB scale positioned to match fader math */
.daw-ch-db-scale { 
  display:flex; 
  flex-direction:column; 
  height:180px; 
  padding:0; 
  margin-left:3px; 
  flex-shrink:0; 
  pointer-events:none; 
  width:14px;
  position:relative;
}
.daw-ch-db-scale span:nth-child(1) { position:absolute; top:0px; }      /* +6  at 100% */
.daw-ch-db-scale span:nth-child(2) { position:absolute; top:41px; }     /* 0   at 75% */
.daw-ch-db-scale span:nth-child(3) { position:absolute; top:86px; }     /* -6  at 50% */
.daw-ch-db-scale span:nth-child(4) { position:absolute; top:131px; }    /* -12 at 25% */
.daw-ch-db-scale span:nth-child(5) { position:absolute; top:153px; }    /* -18 at 13% */
.daw-ch-db-scale span:nth-child(6) { position:absolute; bottom:0px; }   /* -∞  at 0% */
.daw-ch-db-scale span { font-size:8px; color:#7a9ab6; font-weight:600; font-family:var(--rs-font); line-height:1; display:block; text-align:right; padding-right:2px; }


/* Hardware fader cap — writing-mode:vertical so width=cross-axis, height=along-axis */
.daw-ch-fader input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none !important;
  appearance: none !important;
  width: 20px !important;
  height: 36px !important;
  border-radius: 2px !important;
  background:
    linear-gradient(180deg, transparent 47%, #111 47%, #111 53%, transparent 53%),
    linear-gradient(90deg,
      #d0d8e4 0%,
      #a0b0c0 20%,
      #7a8fa0 50%,
      #a0b0c0 80%,
      #d0d8e4 100%
    ) !important;
  border-left: 2px solid #eef2f6 !important;
  border-right: 2px solid #3a4858 !important;
  border-top: 1px solid #607888 !important;
  border-bottom: 1px solid #607888 !important;
  box-shadow: 2px 0 8px rgba(0,0,0,.7), -1px 0 4px rgba(0,0,0,.4) !important;
  cursor: grab !important;
}
.daw-ch-fader input[type="range"]:active::-webkit-slider-thumb {
  cursor: grabbing !important;
}

