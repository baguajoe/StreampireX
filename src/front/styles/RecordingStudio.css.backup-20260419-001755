.rs-sb-cat:hover { color: #cdd9e5; border-color: #00ffc8; }
.rs-sb-cat.active { background: #00ffc8; color: #06060f; border-color: #00ffc8; }

.rs-sb-list { padding: 6px; display: flex; flex-direction: column; gap: 2px; }
.rs-sb-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  background: #0f1422;
  border: 1px solid #1a1f2e;
  border-radius: 3px;
  cursor: grab;
  transition: all 0.1s;
}
.rs-sb-item:hover { background: #131a2b; border-color: #00ffc855; }
.rs-sb-item:active { cursor: grabbing; }
.rs-sb-item-icon { font-size: 18px; flex-shrink: 0; }
.rs-sb-item-body { flex: 1; min-width: 0; }
.rs-sb-item-name { font-size: 12px; font-weight: 600; color: #e6edf3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rs-sb-item-cat { font-size: 10px; color: #7a9ab6; }
.rs-sb-tier {
  font-size: 9px;
  color: #00ffc8;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 2px 5px;
  background: rgba(0,255,200,0.08);
  border-radius: 2px;
  flex-shrink: 0;
}
.rs-sb-star {
  background: transparent;
  border: none;
  color: #4e6a82;
  font-size: 14px;
  cursor: pointer;
  padding: 2px;
  flex-shrink: 0;
  transition: color 0.1s;
}
.rs-sb-star:hover { color: #ffaa00; }
.rs-sb-star.on { color: #ffaa00; }

.rs-sb-embed { height: 100%; overflow: auto; }

/* Sidebar toggle buttons in toolbar */
.rs-sb-toggle-btn {
  width: 28px;
  height: 24px;
  background: #0f1422;
  border: 1px solid #2a3248;
  color: #7a9ab6;
  font-size: 12px;
  cursor: pointer;
  border-radius: 3px;
  margin-left: 4px;
  transition: all 0.12s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.rs-sb-toggle-btn:hover { background: #131a2b; color: #cdd9e5; }
.rs-sb-toggle-btn.active { background: #00ffc8; color: #06060f; border-color: #00ffc8; }

/* ═══ SIDEBAR LAYOUT — override .daw position:fixed when wrapped ═══ */
.rs-layout-root {
  display: flex;
  flex-direction: row;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1300;  /* same z-index as original .daw to replace it */
}
.rs-layout-main {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
.rs-layout-main > .daw {
  position: static !important;  /* undo the position:fixed */
  width: 100% !important;
  height: 100% !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;
  z-index: auto !important;
  flex: 1 1 auto;
}
.rs-sidebar { flex: 0 0 auto; height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
.rs-sidebar-left { width: 240px; }
.rs-sidebar-right { width: 300px; }
