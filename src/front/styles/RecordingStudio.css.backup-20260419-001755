/* ─────────────────────────────────────────────────────────────
   CHANNEL CONTEXT MENU  (Cubase-style, fixed-position)
   Added by fix_recording_studio_both.py
   ───────────────────────────────────────────────────────────── */
.channel-context-menu {
  position: fixed;
  top: 72px;
  right: 24px;
  min-width: 260px;
  max-width: 320px;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  background: #1a1e2a;
  border: 1px solid #2a3248;
  border-radius: 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8),
              0 0 0 1px rgba(0, 255, 200, 0.12);
  z-index: 9999;
  padding: 4px 0;
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  animation: ctxMenuIn 120ms ease;
}

@keyframes ctxMenuIn {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: none; }
}

.channel-context-menu .ctx-header {
  padding: 8px 14px 6px;
  font-size: 10px;
  letter-spacing: 0.5px;
  color: #00ffc8;
  text-transform: uppercase;
  border-bottom: 1px solid #2a3248;
  margin-bottom: 4px;
}

.channel-context-menu .ctx-separator {
  height: 1px;
  background: #2a3248;
  margin: 4px 0;
}

.channel-context-menu .arr-ctx-item {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 7px 14px;
  background: transparent;
  border: none;
  color: #d4dde8;
  font-family: inherit;
  font-size: 11px;
  text-align: left;
  cursor: pointer;
  transition: background 100ms, color 100ms;
}

.channel-context-menu .arr-ctx-item:hover {
  background: rgba(0, 255, 200, 0.08);
  color: #00ffc8;
}

.channel-context-menu .arr-ctx-item.danger {
  color: #ff3b30;
}

.channel-context-menu .arr-ctx-item.danger:hover {
  background: rgba(255, 59, 48, 0.12);
  color: #ff6b60;
}

/* Mobile / narrow viewport: center on screen */
@media (max-width: 600px) {
  .channel-context-menu {
    top: 50%;
    right: 50%;
    transform: translate(50%, -50%);
    max-height: 80vh;
  }
}
/* ───────────────────────── END context menu ───────────────── */

/* ── METER dB scale (right side of channel) ──
   Aligned to CubaseMeter: pos = (db + 60) / 66 on 180px track
   Top pixel offset = 180 - pos*180 - 4 (to center 8px label on meter tick) */
.daw-ch-meter-scale {
  display: flex;
  flex-direction: column;
  height: 180px;
  padding: 0;
  margin-left: 3px;
  flex-shrink: 0;
  pointer-events: none;
  width: 18px;
  position: relative;
}
.daw-ch-meter-scale span:nth-child(1) { position: absolute; top: 0px; }    /* 0   at 100% top */
.daw-ch-meter-scale span:nth-child(2) { position: absolute; top: 45px; }   /* -6  at 75% */
.daw-ch-meter-scale span:nth-child(3) { position: absolute; top: 90px; }   /* -12 at 50% */
.daw-ch-meter-scale span:nth-child(4) { position: absolute; top: 131px; }  /* -18 at 28% */
.daw-ch-meter-scale span:nth-child(5) { position: absolute; top: 153px; }  /* -24 at 13% */
.daw-ch-meter-scale span:nth-child(6) { position: absolute; bottom: 0px; } /* -inf at 0% */
.daw-ch-meter-scale span {
  font-size: 8px;
  color: #7a9ab6;
  font-weight: 600;
  font-family: var(--rs-font);
  line-height: 1;
  display: block;
  text-align: left;
  padding-left: 2px;
}

