/* ============================================================
   RecordingStudio.css — Clean rewrite
   Design tokens: bg #06060f · teal #00ffc8 · orange #FF6600
   ============================================================ */

/* ── CSS Variables ─────────────────────────────────────────── */
:root {
  --rs-bg:          #06060f;
  --rs-bg-2:        #0d1117;
  --rs-bg-3:        #131820;
  --rs-bg-4:        #161b22;
  --rs-border:      #21262d;
  --rs-border-2:    #2a3040;
  --rs-teal:        #00ffc8;
  --rs-orange:      #FF6600;
  --rs-orange-2:    #ff8a3d;
  --rs-purple:      #a78bfa;
  --rs-text:        #cdd9e5;
  --rs-text-dim:    #8b949e;
  --rs-text-faint:  #4e6a82;
  --rs-red:         #f85149;
  --rs-green:       #30d158;
  --rs-yellow:      #ffd60a;
  --rs-radius-sm:   4px;
  --rs-radius:      8px;
  --rs-radius-lg:   12px;
  --rs-radius-xl:   18px;
  --rs-shadow:      0 2px 8px rgba(0,0,0,0.4);
  --rs-shadow-md:   0 4px 16px rgba(0,0,0,0.5);
  --rs-shadow-lg:   0 8px 32px rgba(0,0,0,0.6);
}

/* ── Root container ────────────────────────────────────────── */
.daw {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--rs-bg);
  color: var(--rs-text);
  font-family: 'JetBrains Mono', 'Share Tech Mono', monospace;
  font-size: 12px;
  overflow: hidden;
}

/* ── Top bar ───────────────────────────────────────────────── */
.daw-topbar {
  display: flex;
  align-items: center;
  height: 48px;
  min-height: 48px;
  background: var(--rs-bg-2);
  border-bottom: 1px solid var(--rs-border);
  padding: 0 8px;
  gap: 6px;
  overflow: hidden;
  flex-shrink: 0;
  z-index: 10;
}

.daw-topbar-left {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.daw-topbar-center-tabs {
  display: flex;
  align-items: center;
  gap: 3px;
  flex: 1;
  overflow: hidden;
}

.daw-topbar-right {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  margin-left: auto;
}

/* ── Transport buttons ─────────────────────────────────────── */
.daw-btn,
.daw-icon-btn,
.daw-tiny-btn,
.daw-transport-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-dim);
  cursor: pointer;
  font-family: inherit;
  font-size: 11px;
  padding: 4px 8px;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
  white-space: nowrap;
}
.daw-btn:hover,
.daw-icon-btn:hover,
.daw-tiny-btn:hover,
.daw-transport-btn:hover {
  background: var(--rs-bg-4);
  color: var(--rs-text);
  border-color: var(--rs-border-2);
}
.daw-icon-btn { width: 28px; height: 28px; padding: 0; font-size: 13px; }
.daw-tiny-btn { padding: 2px 6px; font-size: 10px; }

.daw-transport-btn.active,
.daw-icon-btn.active {
  background: rgba(0,255,200,0.12);
  border-color: var(--rs-teal);
  color: var(--rs-teal);
}
.daw-transport-btn.daw-play-btn.active { background: rgba(0,255,200,0.15); color: var(--rs-teal); }
.daw-transport-btn.daw-rec-btn.active  { background: rgba(248,81,73,0.15); border-color: var(--rs-red); color: var(--rs-red); }
.daw-transport-btn.daw-metro-btn.active { background: rgba(255,214,10,0.12); border-color: var(--rs-yellow); color: var(--rs-yellow); }
.daw-icon-btn.saving { color: var(--rs-teal); animation: pulse 1s infinite; }

/* ── LCD display ───────────────────────────────────────────── */
.daw-lcd {
  display: flex;
  align-items: center;
  gap: 4px;
  background: #050810;
  border: 1px solid #1a2030;
  border-radius: var(--rs-radius-sm);
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
}
.daw-lcd-time { color: var(--rs-teal); font-size: 13px; font-variant-numeric: tabular-nums; }
.daw-lcd-sep  { color: #2a3040; }
.daw-lcd-bpm  { color: var(--rs-orange-2); }

/* ── View tabs ─────────────────────────────────────────────── */
.daw-view-tab {
  display: flex;
  align-items: center;
  gap: 4px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-faint);
  cursor: pointer;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 4px 10px;
  white-space: nowrap;
  transition: all 0.15s;
  flex-shrink: 0;
}
.daw-view-tab:hover {
  background: rgba(255,255,255,0.05);
  color: var(--rs-text);
  border-color: var(--rs-border);
}
.daw-view-tab.active {
  background: rgba(0,255,200,0.1);
  border-color: rgba(0,255,200,0.35);
  color: var(--rs-teal);
}
.daw-view-tab.ai-tab.active {
  background: rgba(167,139,250,0.12);
  border-color: rgba(167,139,250,0.4);
  color: var(--rs-purple);
}

/* Mix dropdown tab */
.daw-mix-dropdown {
  position: relative;
  flex-shrink: 0;
}
.daw-mix-dropdown-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-faint);
  cursor: pointer;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 4px 10px;
  white-space: nowrap;
  transition: all 0.15s;
}
.daw-mix-dropdown-btn:hover,
.daw-mix-dropdown-btn.active {
  background: rgba(0,255,200,0.1);
  border-color: rgba(0,255,200,0.35);
  color: var(--rs-teal);
}
.daw-mix-dropdown-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  background: var(--rs-bg-4);
  border: 1px solid var(--rs-border-2);
  border-radius: var(--rs-radius);
  box-shadow: var(--rs-shadow-lg);
  min-width: 180px;
  z-index: 100;
  padding: 4px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.daw-mix-dropdown-item {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-dim);
  cursor: pointer;
  font-family: inherit;
  font-size: 11px;
  padding: 6px 10px;
  text-align: left;
  width: 100%;
  transition: all 0.1s;
}
.daw-mix-dropdown-item:hover {
  background: rgba(255,255,255,0.06);
  color: var(--rs-text);
}
.daw-mix-dropdown-item.active {
  background: rgba(0,255,200,0.1);
  color: var(--rs-teal);
}

/* ── Input meter ───────────────────────────────────────────── */
.daw-input-meter {
  width: 80px;
  height: 6px;
  background: #0d1117;
  border: 1px solid var(--rs-border);
  border-radius: 3px;
  overflow: hidden;
}
.daw-input-meter-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--rs-teal), var(--rs-orange));
  transition: width 0.05s;
}

/* ── Status bar ────────────────────────────────────────────── */
.daw-status {
  font-size: 10px;
  color: var(--rs-text-faint);
  padding: 0 8px;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Main area ─────────────────────────────────────────────── */
.daw-main {
  display: flex;
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

/* ── Split screen ──────────────────────────────────────────── */
.rs-split-screen {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}
.rs-split-top {
  overflow: hidden;
  flex-shrink: 0;
}
.rs-split-bottom {
  flex: 1;
  overflow: hidden;
  min-height: 0;
}
.rs-split-handle {
  height: 4px;
  background: var(--rs-border-2);
  cursor: row-resize;
  flex-shrink: 0;
  transition: background 0.15s;
}
.rs-split-handle:hover { background: var(--rs-teal); }
.rs-split-pane-label {
  font-size: 9px;
  font-weight: 700;
  color: var(--rs-text-faint);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 2px 8px;
  background: var(--rs-bg-2);
  border-bottom: 1px solid var(--rs-border);
}
.rs-split-toggle-btn {
  padding: 3px 8px;
  font-size: 10px;
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-faint);
  cursor: pointer;
}
.rs-split-toggle-btn.active {
  background: rgba(0,255,200,0.1);
  border-color: var(--rs-teal);
  color: var(--rs-teal);
}

/* ── Arrange / Tracks view ─────────────────────────────────── */
.daw-tracks-area {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  background: var(--rs-bg);
}
.daw-tracks-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: var(--rs-bg-2);
  border-bottom: 1px solid var(--rs-border);
  flex-shrink: 0;
}
.daw-tracks-toolbar-label {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--rs-text-faint);
  text-transform: uppercase;
}
.daw-tracks-toolbar-controls { display: flex; align-items: center; gap: 4px; }
.daw-tracks-toolbar-btn {
  width: 24px; height: 24px;
  display: flex; align-items: center; justify-content: center;
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-dim);
  cursor: pointer;
  transition: all 0.15s;
}
.daw-tracks-toolbar-btn.add:hover  { background: rgba(0,255,200,0.1); border-color: var(--rs-teal); color: var(--rs-teal); }
.daw-tracks-toolbar-btn.remove:hover { background: rgba(248,81,73,0.1); border-color: var(--rs-red); color: var(--rs-red); }
.daw-track-type-select {
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-dim);
  font-family: inherit;
  font-size: 10px;
  padding: 3px 6px;
}

/* Track row */
.daw-track-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1px solid var(--rs-border);
  min-height: 48px;
  transition: background 0.1s;
}
.daw-track-row:hover { background: rgba(255,255,255,0.02); }
.daw-track-row.selected { background: rgba(0,255,200,0.04); }
.daw-track-row.armed { background: rgba(248,81,73,0.04); }
.daw-track-row.muted { opacity: 0.5; }
.daw-track-row.fx-open { background: rgba(167,139,250,0.05); }

.daw-track-color-bar {
  width: 4px;
  flex-shrink: 0;
  border-radius: 2px 0 0 2px;
}
.daw-track-btns {
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 0 6px;
  width: 160px;
  flex-shrink: 0;
  background: var(--rs-bg-2);
  border-right: 1px solid var(--rs-border);
}
.daw-track-actions-strip {
  display: flex;
  align-items: center;
  gap: 2px;
}
.daw-track-name-input {
  background: transparent;
  border: none;
  color: var(--rs-text);
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  outline: none;
  width: 100%;
}
.daw-badge {
  width: 20px; height: 20px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  font-size: 9px;
  font-weight: 800;
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  color: var(--rs-text-faint);
  cursor: pointer;
  transition: all 0.1s;
}
.daw-badge.m.on { background: rgba(255,214,10,0.15); border-color: var(--rs-yellow); color: var(--rs-yellow); }
.daw-badge.s.on { background: rgba(0,255,200,0.15); border-color: var(--rs-teal); color: var(--rs-teal); }
.daw-badge.r.on { background: rgba(248,81,73,0.15); border-color: var(--rs-red); color: var(--rs-red); }
.daw-type-icon { font-size: 14px; }
.daw-armed-label {
  font-size: 8px;
  font-weight: 800;
  color: var(--rs-red);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.daw-rec-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--rs-red);
  animation: pulse 1s infinite;
}
.daw-pan-slider { width: 60px; accent-color: var(--rs-teal); }
.daw-pan-val { font-size: 9px; color: var(--rs-text-faint); min-width: 24px; text-align: center; }
.daw-knob-slider { width: 50px; accent-color: var(--rs-orange); }
.daw-input-select {
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-sm);
  color: var(--rs-text-dim);
  font-family: inherit;
  font-size: 10px;
  padding: 2px 4px;
}

/* Region blocks */
.daw-region-block {
  background: color-mix(in srgb, var(--region-color, var(--rs-teal)) 20%, transparent);
  border: 1px solid color-mix(in srgb, var(--region-color, var(--rs-teal)) 50%, transparent);
  border-radius: var(--rs-radius-sm);
  overflow: hidden;
  position: relative;
  height: 100%;
  cursor: pointer;
}
.daw-region-label {
  font-size: 9px;
  font-weight: 700;
  padding: 2px 4px;
  color: var(--rs-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.daw-region-empty {
  opacity: 0.3;
  font-size: 9px;
  color: var(--rs-text-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.daw-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: var(--rs-text-faint);
  font-size: 11px;
  opacity: 0.5;
}
.daw-divider {
  width: 1px;
  height: 20px;
  background: var(--rs-border);
  margin: 0 4px;
  flex-shrink: 0;
}

/* ── Console mixer ─────────────────────────────────────────── */
.daw-console {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  background: var(--rs-bg);
}
.daw-console-scroll {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 6px;
  padding: 10px;
  overflow-x: auto;
  overflow-y: hidden;
  flex: 1;
  min-height: 0;
}

/* Channel strip */
.daw-channel {
  display: flex;
  flex-direction: column;
  width: 140px;
  min-width: 140px;
  max-width: 140px;
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-lg);
  padding: 8px;
  gap: 6px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
  flex-shrink: 0;
}
.daw-channel:hover { border-color: var(--rs-border-2); }
.daw-channel.selected {
  border-color: rgba(0,255,200,0.4);
  background: rgba(0,255,200,0.03);
}
.master-channel {
  border-color: rgba(255,138,61,0.3);
  box-shadow: 0 0 16px rgba(255,138,61,0.08);
}
.master-channel:hover { border-color: rgba(255,138,61,0.5); }

/* Channel sections */
.daw-ch-routing {
  display: flex;
  flex-direction: column;
  gap: 3px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: var(--rs-radius-sm);
  padding: 6px;
  flex-shrink: 0;
}
.daw-ch-routing-label {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--rs-text-faint);
}
.daw-ch-routing-value {
  font-size: 9px;
  color: var(--rs-text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.daw-ch-inserts {
  display: flex;
  flex-direction: column;
  gap: 3px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: var(--rs-radius-sm);
  padding: 6px;
  min-height: 60px;
  flex-shrink: 0;
}
.daw-ch-inserts-label {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--rs-text-faint);
}
.daw-ch-track-name-top {
  font-size: 10px;
  font-weight: 700;
  color: var(--rs-text);
  letter-spacing: 0.04em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.daw-ch-insert-slot {
  font-size: 9px;
  padding: 3px 5px;
  border-radius: var(--rs-radius-sm);
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.daw-ch-insert-slot.active {
  background: rgba(0,255,200,0.08);
  border: 1px solid rgba(0,255,200,0.2);
  color: var(--rs-text);
}
.daw-ch-insert-slot.empty {
  color: var(--rs-text-faint);
  border: 1px dashed rgba(255,255,255,0.1);
  text-align: center;
  opacity: 0.6;
}
.daw-ch-insert-slot.empty:hover {
  border-color: rgba(0,255,200,0.3);
  color: var(--rs-teal);
  opacity: 1;
}

/* Controls row M/S/e */
.daw-ch-controls {
  display: flex;
  align-items: center;
  gap: 4px;
  justify-content: center;
  flex-shrink: 0;
}
.daw-ch-badge,
.daw-ch-btn {
  width: 24px; height: 24px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  font-size: 9px;
  font-weight: 800;
  background: var(--rs-bg-4);
  border: 1px solid var(--rs-border);
  color: var(--rs-text-faint);
  cursor: pointer;
  transition: all 0.1s;
  flex-shrink: 0;
}
.daw-ch-badge.m-on,
.daw-ch-btn.mute.active { background: rgba(255,214,10,0.15); border-color: var(--rs-yellow); color: var(--rs-yellow); }
.daw-ch-badge.s-on,
.daw-ch-btn.solo.active { background: rgba(0,255,200,0.15); border-color: var(--rs-teal); color: var(--rs-teal); }
.daw-ch-badge.e-on { background: rgba(167,139,250,0.15); border-color: var(--rs-purple); color: var(--rs-purple); }
.daw-ch-rec-btn { background: var(--rs-bg-4); border: 1px solid var(--rs-border); border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--rs-text-faint); }
.daw-ch-rec-btn.armed { background: rgba(248,81,73,0.2); border-color: var(--rs-red); color: var(--rs-red); }

/* Pan knob */
.daw-ch-pan {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Fader area — fills remaining space */
.daw-ch-fader-area {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 160px;
  background: rgba(0,0,0,0.2);
  border-radius: var(--rs-radius-sm);
  padding: 6px;
  gap: 4px;
}
.daw-ch-fader-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  flex: 1;
  gap: 6px;
}
.daw-ch-fader {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}
.daw-ch-fader input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  writing-mode: vertical-lr;
  direction: rtl;
  width: 28px;
  height: 100%;
  background: transparent;
  cursor: pointer;
}
.daw-ch-fader input[type="range"]::-webkit-slider-runnable-track {
  width: 4px;
  background: var(--rs-border-2);
  border-radius: 2px;
}
.daw-ch-fader input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 28px;
  height: 10px;
  background: #c0c8d0;
  border-radius: 3px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.5);
  cursor: grab;
}
.daw-ch-fader input[type="range"]::-webkit-slider-thumb:active { cursor: grabbing; background: #ffffff; }
.daw-ch-fader input[type="range"]::-moz-range-track { width: 4px; background: var(--rs-border-2); border-radius: 2px; }
.daw-ch-fader input[type="range"]::-moz-range-thumb { width: 28px; height: 10px; background: #c0c8d0; border-radius: 3px; border: none; cursor: grab; }

/* Master fader thumb — orange tint */
.master-channel .daw-ch-fader input[type="range"]::-webkit-slider-thumb { background: #d0a080; }
.master-channel .daw-ch-fader input[type="range"]::-moz-range-thumb { background: #d0a080; }

/* Meter */
.daw-ch-meter {
  width: 14px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: #050810;
  border-radius: 2px;
  overflow: hidden;
  border: 1px solid var(--rs-border);
  flex-shrink: 0;
}
.daw-ch-meter-bar {
  width: 100%;
  background: var(--rs-teal);
  transition: height 0.05s;
  border-radius: 1px;
}

/* Volume display */
.daw-ch-vol-display {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.daw-ch-vol-val,
.daw-ch-vol-readout {
  font-size: 10px;
  font-weight: 700;
  color: var(--rs-text-dim);
  text-align: center;
  background: var(--rs-bg-2);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius-sm);
  padding: 2px 6px;
  min-width: 40px;
}
.master-channel .daw-ch-vol-val,
.master-channel .daw-ch-vol-readout { color: var(--rs-orange-2); }

/* R/W automation */
.daw-ch-automation {
  display: flex;
  align-items: center;
  gap: 4px;
  justify-content: center;
  flex-shrink: 0;
}
.daw-ch-rw {
  width: 20px; height: 20px;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 800;
  background: var(--rs-bg-4);
  border: 1px solid var(--rs-border);
  border-radius: 3px;
  color: var(--rs-text-faint);
  cursor: pointer;
}
.daw-ch-rw.active { background: rgba(255,102,0,0.15); border-color: var(--rs-orange); color: var(--rs-orange); }

/* Rec arm */
.daw-ch-rec { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

/* Track name at bottom */
.daw-ch-name {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 4px;
  border-top: 1px solid var(--rs-border);
  flex-shrink: 0;
}
.daw-ch-name-input {
  background: transparent;
  border: none;
  color: var(--rs-text);
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  text-align: center;
  outline: none;
  width: 100%;
  letter-spacing: 0.04em;
}
.daw-ch-name-input:focus {
  background: rgba(255,255,255,0.05);
  border-radius: 3px;
}
.daw-ch-number {
  font-size: 9px;
  color: var(--rs-text-faint);
}
.daw-ch-type-icon { font-size: 12px; }

/* Console select */
.daw-ch-console-select {
  width: 100%;
  background: var(--rs-bg-2);
  border: 1px solid var(--rs-border);
  border-radius: 3px;
  font-size: 9px;
  padding: 1px 2px;
  font-family: inherit;
  color: var(--rs-text-faint);
}
.daw-ch-track-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

/* Name/bottom section variants */
.daw-ch-name-bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 4px;
  border-top: 1px solid var(--rs-border);
  flex-shrink: 0;
}

/* ── Piano roll view ───────────────────────────────────────── */
.daw-pianoroll-view { flex: 1; overflow: auto; height: 100%; }
.daw-piano-view { flex: 1; width: 100%; height: 100%; display: flex; flex-direction: column; }
.daw-chords-view { flex: 1; overflow: auto; }

/* ── Instrument/tool views ─────────────────────────────────── */
.daw-synth-view,
.daw-drumdesigner-view,
.daw-instrbuilder-view,
.daw-aimix-view,
.daw-aibeat-view,
.daw-keyfinder-view,
.daw-freesound-view { flex: 1; overflow: auto; height: 100%; }

/* ── Modals ────────────────────────────────────────────────── */
.daw-modal-overlay,
.rs-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.75);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.daw-modal,
.rs-modal-panel {
  width: 90%;
  max-width: 900px;
  max-height: 90vh;
  overflow: auto;
  background: var(--rs-bg-4);
  border-radius: var(--rs-radius-lg);
  border: 1px solid var(--rs-border-2);
  box-shadow: var(--rs-shadow-lg);
  position: relative;
}
.rs-modal-close {
  position: absolute;
  top: 8px; right: 12px;
  background: none;
  border: none;
  color: var(--rs-text);
  font-size: 18px;
  cursor: pointer;
  z-index: 10;
}
.daw-plugin-modal,
.rs-plugin-modal {
  position: fixed;
  top: 60px; right: 20px;
  z-index: 900;
  width: min(900px, 60vw);
  max-height: 80vh;
  overflow-y: auto;
  background: var(--rs-bg-4);
  border: 1px solid var(--rs-border-2);
  border-radius: var(--rs-radius-lg);
  box-shadow: var(--rs-shadow-lg);
}

/* ── Project list ──────────────────────────────────────────── */
.daw-project-list { display: flex; flex-direction: column; gap: 4px; padding: 8px; }
.daw-project-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  background: var(--rs-bg-3);
  border: 1px solid var(--rs-border);
  border-radius: var(--rs-radius);
  cursor: pointer;
  transition: all 0.1s;
}
.daw-project-item:hover { border-color: var(--rs-border-2); background: var(--rs-bg-4); }
.daw-project-name { font-size: 12px; font-weight: 700; color: var(--rs-text); }
.daw-project-meta { font-size: 10px; color: var(--rs-text-faint); }

/* ── Extracted rs-* utility classes ───────────────────────── */
.rs-wam-badge { display:flex; align-items:center; gap:6px; padding:2px 8px; background:rgba(124,58,237,0.08); border-radius:6px; border:1px solid rgba(124,58,237,0.2); }
.rs-wam-text { font-size:10px; color:#a78bfa; font-weight:700; }
.rs-mic-name { font-weight:700; }
.rs-mic-desc { font-size:0.65rem; opacity:0.75; }
.rs-settings-section { margin-bottom:16px; }
.rs-settings-label { color:var(--rs-text-faint); font-size:11px; display:block; margin-bottom:6px; }
.rs-settings-row { display:flex; gap:6px; }
.rs-settings-title { color:var(--rs-text); font-weight:800; font-size:14px; letter-spacing:0.1em; }
.rs-settings-panel { padding:24px; max-width:560px; display:flex; flex-direction:column; gap:20px; }
.rs-close-btn { background:none; border:none; color:var(--rs-text-faint); cursor:pointer; font-size:16px; }
.rs-latency-box { margin-bottom:16px; padding:10px 14px; background:#080c12; border-radius:8px; border:1px solid #1c2128; }
.rs-stat-row { display:flex; justify-content:space-between; margin-bottom:6px; }
.rs-stat-row-last { display:flex; justify-content:space-between; }
.rs-stat-label { color:var(--rs-text-faint); font-size:11px; }
.rs-stat-val-teal { color:var(--rs-teal); font-weight:700; font-size:12px; }
.rs-stat-val { color:var(--rs-text); font-size:11px; }
.rs-hint { color:#484f58; font-size:10px; margin-top:4px; }
.rs-hint-center { color:#484f58; font-size:10px; text-align:center; }
.rs-hint-sm { color:var(--rs-text-faint); font-size:11px; margin-top:16px; }
.rs-view-full { flex:1; width:100%; height:100%; display:flex; flex-direction:column; }
.rs-view-scroll { display:flex; flex-direction:column; width:100%; height:100%; overflow:auto; }
.rs-view-auto { flex:1; overflow:auto; height:100%; }
.rs-flex-hidden { flex:1; min-height:0; overflow:hidden; }
.rs-flex-scroll-dark { flex:1; min-height:0; overflow-y:auto; background:#06090f; }
.rs-flex-scroll-darker { flex:1; min-height:0; overflow-y:auto; background:#06060f; }
.rs-bottom-toolbar { padding:12px 16px; border-top:1px solid #30363d; display:flex; align-items:center; gap:12px; }
.rs-action-btn-teal { background:rgba(0,255,200,0.1); color:var(--rs-teal); border:1px solid rgba(0,255,200,0.3); border-radius:8px; padding:8px 16px; cursor:pointer; font-size:0.85rem; font-weight:600; }
.rs-muted-text { font-size:0.78rem; color:var(--rs-text-dim); }
.rs-analog-scale { transform:scale(1.2); transform-origin:top left; width:83.33%; min-height:100%; }
.rs-console-scroll { height:100%; overflow:auto; }
.rs-insert-empty-text { font-size:0.55rem; color:#5a7088; }
.rs-master-label { font-weight:700; font-size:0.62rem; color:#ddeeff; }
.rs-relative { position:relative; }
.rs-orange { color:var(--rs-orange-2); }
.rs-transport-label { font-size:0.7rem; font-weight:800; }
.rs-send-btn { margin-top:10px; }
.rs-remove-item { padding:4px 14px; font-size:0.65rem; color:#e53935; cursor:pointer; }
.rs-divider { border-top:1px solid #0f1820; margin:4px 0; }
.rs-lib-badge { font-size:8px; background:#ff9800; color:#000; border-radius:2px; padding:1px 3px; font-weight:800; }
.rs-sidebar-section-header { border-top:2px solid #1a2a3a; margin:6px 0 2px; padding:4px 10px 2px; }
.rs-sidebar-section-label { font-size:0.55rem; color:#ff9800; font-weight:700; letter-spacing:1px; text-transform:uppercase; }
.rs-sidebar-item-label { padding:5px 10px 2px; font-size:0.52rem; color:#ff9800; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; }
.rs-toggle-label { display:flex; align-items:center; gap:6px; cursor:pointer; }
.rs-param-row { margin-bottom:12px; }
.rs-param-header { display:flex; justify-content:space-between; font-size:11px; color:var(--rs-text-faint); margin-bottom:5px; }
.rs-range-orange { width:100%; accent-color:#ff6600; }
.rs-range-yellow { width:100%; accent-color:#ffd60a; }
.rs-range-teal { width:100%; accent-color:var(--rs-teal); }
.rs-chain-grid { display:flex; gap:12px; flex-wrap:wrap; }
.rs-effect-card { width:100px; height:120px; background:var(--rs-bg-2); border:1px solid var(--rs-border); border-radius:10px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; cursor:pointer; }
.rs-effect-icon { font-size:28px; }
.rs-effect-name { font-size:10px; font-weight:700; color:var(--rs-text-dim); }
.rs-effect-knob { width:22px; height:22px; border-radius:50%; border:2px solid #ff6600; background:var(--rs-bg-4); }
.rs-amp-panel { padding:24px; }
.rs-amp-heading { color:var(--rs-text); font-weight:800; font-size:20px; margin:0 0 6px; }
.rs-amp-subtext { color:var(--rs-text-dim); font-size:14px; margin:0 0 20px; }
.rs-amp-scale { transform:scale(1.25); transform-origin:top left; width:80%; }
.rs-dark-card { background:var(--rs-bg-2); border:1px solid var(--rs-border); border-radius:12px; padding:20px; }
.rs-card-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
.rs-card-title { color:var(--rs-text); font-weight:800; margin:0 0 4px; }
.rs-card-subtitle { color:var(--rs-text-dim); font-size:12px; margin:0; }
.rs-console-panel { padding:16px; }
.rs-console-label { font-size:11px; color:var(--rs-teal); font-family:"Share Tech Mono",monospace; letter-spacing:1px; margin-bottom:12px; }
.rs-console-btn-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
.rs-master-bus-label { font-size:10px; color:var(--rs-text-faint); margin-bottom:8px; }
.rs-console-hint { font-size:10px; color:var(--rs-text-faint); font-family:"Share Tech Mono",monospace; }
.rs-analog-tabs { display:flex; background:var(--rs-bg-2); border-bottom:1px solid var(--rs-border); padding:0 12px; }

/* Split screen */
.rs-split-screen { display:flex; flex-direction:column; flex:1; overflow:hidden; }
.rs-split-top { overflow:hidden; flex-shrink:0; }
.rs-split-bottom { flex:1; overflow:hidden; min-height:0; }
.rs-split-handle { height:4px; background:var(--rs-border-2); cursor:row-resize; flex-shrink:0; transition:background 0.15s; }
.rs-split-handle:hover { background:var(--rs-teal); }
.rs-split-pane-label { font-size:9px; font-weight:700; color:var(--rs-text-faint); letter-spacing:0.08em; text-transform:uppercase; padding:2px 8px; background:var(--rs-bg-2); border-bottom:1px solid var(--rs-border); }
.rs-split-toggle-btn { padding:3px 8px; font-size:10px; background:var(--rs-bg-3); border:1px solid var(--rs-border); border-radius:var(--rs-radius-sm); color:var(--rs-text-faint); cursor:pointer; }
.rs-split-toggle-btn.active { background:rgba(0,255,200,0.1); border-color:var(--rs-teal); color:var(--rs-teal); }

/* ── Animations ────────────────────────────────────────────── */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ── Responsive ────────────────────────────────────────────── */
@media (max-width: 768px) {
  .daw-channel { width: 110px; min-width: 110px; max-width: 110px; }
  .daw-track-btns { width: 120px; }
}
