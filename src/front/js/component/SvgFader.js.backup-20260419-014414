import React, { useRef, useCallback } from "react";

// Cubase-style log fader: 0 dB at 75% travel, +6 dB at top, -60 dB floor
const DB_MIN = -60;
const DB_MAX = 6;
const FADER_WIDTH = 28;
const THUMB_HEIGHT = 14;
const THUMB_WIDTH = 32;

// Convert linear gain (0 to 1.26+) to normalized position (0 to 1, 0=bottom, 1=top)
const volumeToPos = (vol) => {
  if (vol <= 0) return 0;
  const db = 20 * Math.log10(vol);
  if (db >= DB_MAX) return 1;
  if (db <= DB_MIN) return 0;
  if (db >= 0) return 0.75 + (db / DB_MAX) * 0.25;
  // log taper below 0 dB: -6 at 50%, -12 at 25%, -inf at 0
  const norm = Math.pow(10, db / 24);
  return norm * 0.75;
};

// Inverse: normalized position to linear gain
const posToVolume = (pos) => {
  if (pos <= 0) return 0;
  if (pos >= 1) return Math.pow(10, DB_MAX / 20);  // +6 dB = ~2.0
  if (pos >= 0.75) {
    const db = (pos - 0.75) / 0.25 * DB_MAX;
    return Math.pow(10, db / 20);
  }
  const norm = pos / 0.75;
  const db = 24 * Math.log10(norm);
  if (db <= DB_MIN) return 0;
  return Math.pow(10, db / 20);
};

// dB label positions on the 180px track (matches log taper)
const LABELS = [
  { text: "+6",  pos: 1.00 },  // y = 0
  { text: "0",   pos: 0.75 },  // y = 45
  { text: "-6",  pos: 0.50 },  // y = 90
  { text: "-12", pos: 0.25 },  // y = 135
  { text: "-24", pos: 0.10 },  // y = 162
  { text: "-∞",  pos: 0.00 },  // y = 180
];

const SvgFader = ({
  value = 1.0,
  onChange,
  color = "#cdd9e5",
  activeColor = "#00ffc8",
  showScale = true,
  isMaster = false,
  height = 240,
}) => {
  const FADER_HEIGHT = height;
  const ref = useRef(null);
  const dragging = useRef(false);

  const pos = volumeToPos(value);
  const thumbY = FADER_HEIGHT - pos * FADER_HEIGHT - THUMB_HEIGHT / 2;

  const handleMove = useCallback((clientY) => {
    if (!ref.current) return;
    const rect = ref.current.getBoundingClientRect();
    const y = Math.max(0, Math.min(FADER_HEIGHT, clientY - rect.top));
    const newPos = 1 - y / FADER_HEIGHT;
    const newVol = posToVolume(newPos);
    onChange && onChange(newVol);
  }, [onChange]);

  const handleMouseDown = (e) => {
    e.preventDefault();
    dragging.current = true;
    handleMove(e.clientY);
    const onUp = () => {
      dragging.current = false;
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseup", onUp);
    };
    const onMove = (ev) => { if (dragging.current) handleMove(ev.clientY); };
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
  };

  const handleWheel = (e) => {
    e.preventDefault();
    const delta = e.deltaY < 0 ? 0.01 : -0.01;
    const newPos = Math.max(0, Math.min(1, pos + delta));
    onChange && onChange(posToVolume(newPos));
  };

  const handleDblClick = () => { onChange && onChange(1.0); };

  const thumbFill = isMaster
    ? "url(#svgfader-master-grad)"
    : "url(#svgfader-track-grad)";

  const indicatorColor = isMaster ? "#fff" : activeColor;

  return (
    <div className="svg-fader-wrapper" style={{ display: "flex", alignItems: "center", gap: "3px" }}>
      {showScale && (
        <div className="svg-fader-scale" style={{ position: "relative", height: `${FADER_HEIGHT}px`, width: "16px", flexShrink: 0 }}>
          {LABELS.map(l => (
            <span key={l.text} style={{
              position: "absolute",
              right: "2px",
              top: `${FADER_HEIGHT - l.pos * FADER_HEIGHT - 4}px`,
              fontSize: "8px",
              color: "#7a9ab6",
              fontWeight: 600,
              fontFamily: "var(--rs-font)",
              lineHeight: 1,
            }}>{l.text}</span>
          ))}
        </div>
      )}

      <svg
        ref={ref}
        width={FADER_WIDTH}
        height={FADER_HEIGHT}
        onMouseDown={handleMouseDown}
        onWheel={handleWheel}
        onDoubleClick={handleDblClick}
        style={{ cursor: "ns-resize", userSelect: "none", flexShrink: 0 }}
      >
        <defs>
          <linearGradient id="svgfader-track-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#d0d8e4"/>
            <stop offset="50%" stopColor="#8090a4"/>
            <stop offset="100%" stopColor="#a0aab8"/>
          </linearGradient>
          <linearGradient id="svgfader-master-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#ff8a3d"/>
            <stop offset="50%" stopColor="#cc4400"/>
            <stop offset="100%" stopColor="#ff8a3d"/>
          </linearGradient>
        </defs>

        {/* Track groove */}
        <rect x={FADER_WIDTH/2 - 3} y="0" width="6" height={FADER_HEIGHT}
              fill="#060a10" stroke="#0d1520" strokeWidth="1" rx="1"/>

        {/* Thumb handle */}
        <g transform={`translate(0, ${thumbY})`}>
          {/* Thumb body */}
          <rect
            x={(FADER_WIDTH - THUMB_WIDTH) / 2}
            y="0"
            width={THUMB_WIDTH}
            height={THUMB_HEIGHT}
            fill={thumbFill}
            stroke={isMaster ? "#661100" : "#506070"}
            strokeWidth="1"
            rx="2"
          />
          {/* Indicator line — the value pointer */}
          <line
            x1={(FADER_WIDTH - THUMB_WIDTH) / 2 + 2}
            y1={THUMB_HEIGHT / 2}
            x2={(FADER_WIDTH + THUMB_WIDTH) / 2 - 2}
            y2={THUMB_HEIGHT / 2}
            stroke={indicatorColor}
            strokeWidth="2"
            strokeLinecap="round"
          />
        </g>
      </svg>
    </div>
  );
};

export default SvgFader;
export { volumeToPos, posToVolume };
